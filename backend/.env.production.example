NODE_ENV=production
PORT=5000
# Neon: use the pooled connection URL for the running application.
# Prisma migrations should use Neon's direct connection URL manually when running migrate commands.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Generate secrets with: openssl rand -base64 64
JWT_SECRET="REPLACE_WITH_64_BYTE_RANDOM_SECRET"
JWT_EXPIRES_IN=15m
SESSION_JWT_SECRET="REPLACE_WITH_64_BYTE_RANDOM_SECRET"
SESSION_JWT_EXPIRES_IN=12h
CLIENT_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com
BACKEND_URL=https://yourdomain.com
APP_TIMEZONE=Asia/Kolkata
SENTRY_DSN=
LOG_LEVEL=info
LOG_SLOW_REQUEST_MS=1000
LOG_SLOW_QUERY_MS=500
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=200
HEALTH_RATE_LIMIT_WINDOW_MS=60000
HEALTH_RATE_LIMIT_MAX=120
SOCKET_RATE_LIMIT_WINDOW_MS=60000
SOCKET_RATE_LIMIT_MAX=30
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
